{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "vite build --emptyOutDir=false && tsc -b",
    "test": "vitest run",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run knip",
    "preview": "vite preview",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "fix": "oxlint --fix . && bun run format",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@effect/atom-react": "4.1.7",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource-variable/roboto-slab": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^9.0.0-beta.55",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.74.1",
    "@shadcn/lint": "0.2.5",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "^1.168.22",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.0",
    "knip": "6.49.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "~7.0.0",
    "vite": "^8",
    "vitest": "^4.1.10"
  }
}
