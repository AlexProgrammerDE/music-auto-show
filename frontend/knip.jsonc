{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/routes/**/*.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx,css}", "!src/gen/**", "!src/routeTree.gen.ts"],
  // These files are generated by the shadcn preset and kept intact.
  "ignore": ["src/components/ui/**"],
}
