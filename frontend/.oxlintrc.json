{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "builtin": true
  },
  "ignorePatterns": ["dist/**", "src/components/ui/**", "src/gen/**", "src/routeTree.gen.ts"],
  "plugins": [
    "import",
    "jsx-a11y",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest",
    "effecttsgo"
  ],
  "rules": {
    // Pedantic rules left off: size metrics, opinion, or duplicates of configured rules.
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    // Duplicates `typescript/require-await`.
    "eslint/require-await": "off",
    // Conflicts with the `prefer-nullish-coalescing` `ignorePrimitives` setup.
    "typescript/strict-boolean-expressions": "off",
    // Conflicts with `unicorn/no-useless-undefined`, which turns `return undefined` into `return`,
    // for example in effects that return a cleanup on one path. `noImplicitReturns` still applies.
    "typescript/consistent-return": "off",
    // `resolve(undefined)` is required when the promise value type includes undefined.
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
    // Object types are mostly declared with `type` here.
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/array-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-function-type": "error",
    "typescript/consistent-indexed-object-style": "error",
    "unicorn/switch-case-braces": "error",
    "eslint/no-useless-assignment": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-array-index-key": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/no-useless-call": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-unnecessary-condition": "error",
    // Protobuf fields default to 0 and "", and the UI shows a fallback for those defaults.
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "number": true,
          "string": true
        }
      }
    ],
    "typescript/require-await": "error",
    "typescript/no-non-null-assertion": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/strict-effect-provide": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "eslint/array-callback-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-await-in-loop": "off",
    "unicorn/no-abusive-eslint-disable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/enforce-canonical-classes": "error",
    "eslint/no-console": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-throw-literal": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/media-has-caption": "off",
    "promise/catch-or-return": "error",
    "react/react-in-jsx-scope": "off",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^AccordionItem$",
            "allow": ["layout", "px-4"]
          },
          {
            "pattern": "^Alert$",
            "allow": ["layout", "p-4"]
          },
          {
            "pattern": "^AlertDescription$",
            "allow": ["layout", "pr-24"]
          },
          {
            "pattern": "^Badge$",
            "allow": ["layout", "text-tiny"]
          },
          {
            "pattern": "^Card$",
            "allow": ["layout", "gap-0", "py-0", "rounded-none"]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "p-0"]
          },
          {
            "pattern": "^CardDescription$",
            "allow": ["layout", "text-xs", "truncate"]
          },
          {
            "pattern": "^CardHeader$",
            "allow": ["layout", "gap-0", "border-b", "py-2.5"]
          },
          {
            "pattern": "^DrawerFooter$",
            "allow": ["layout", "border-t", "pt-4"]
          },
          {
            "pattern": "^Empty$",
            "allow": ["layout", "border", "py-5", "rounded-none"]
          },
          {
            "pattern": "^Field$",
            "allow": ["layout", "border-r", "p-4"]
          },
          {
            "pattern": "^FieldDescription$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^FieldGroup$",
            "allow": ["layout", "border-t", "gap-4", "gap-5", "p-4"]
          },
          {
            "pattern": "^FieldSet$",
            "allow": ["layout", "border", "border-t", "p-4"]
          },
          {
            "pattern": "^Progress$",
            "allow": [
              "layout",
              "gap-x-3",
              "gap-y-1",
              "gap-y-2",
              "**:data-[slot=progress-indicator]:bg-chart-1",
              "**:data-[slot=progress-indicator]:bg-chart-2",
              "**:data-[slot=progress-indicator]:bg-chart-3",
              "**:data-[slot=progress-indicator]:bg-chart-4",
              "**:data-[slot=progress-indicator]:bg-chart-5",
              "**:data-[slot=progress-indicator]:bg-primary",
              "**:data-[slot=progress-indicator]:bg-destructive"
            ]
          },
          {
            "pattern": "^ProgressLabel$",
            "allow": ["layout", "font-heading", "text-caption", "text-xs"]
          },
          {
            "pattern": "^ProgressValue$",
            "allow": ["layout", "text-caption", "text-xs"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "rounded-none"]
          },
          {
            "pattern": "^TableCell$",
            "allow": ["layout", "p-0"]
          },
          {
            "pattern": "^Tabs$",
            "allow": ["layout", "gap-0", "gap-4"]
          },
          {
            "pattern": "^TabsList$",
            "allow": ["layout", "border-b", "pb-2", "px-1", "px-3", "py-2"]
          },
          {
            "pattern": "^TooltipTrigger$",
            "allow": [
              "layout",
              "bg-muted",
              "border",
              "border-border",
              "border-transparent",
              "font-heading",
              "font-medium",
              "gap-2",
              "hover:text-foreground",
              "px-2.5",
              "text-foreground",
              "text-muted-foreground",
              "text-xs",
              "transition-colors"
            ]
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-top-level-await": "error",
    "react/jsx-no-target-blank": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unknown-property": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ]
  },
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "jsPlugins": ["@shadcn/lint", "eslint-plugin-better-tailwindcss"],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/index.css"
    }
  },
  "overrides": [
    {
      // Tests may print diagnostics.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      // TanStack Router route files export Route next to private route components.
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
